<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.controller.SwimmerController" prefHeight="672.0" prefWidth="1200.0">

    <center>
        <TableView fx:id="schwimmerTableView" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colSchwimmerName" text="Name" prefWidth="200.0"/>
                <TableColumn fx:id="colSchwimmerVerein" text="Verein" prefWidth="200.0"/>
                <TableColumn fx:id="colSchwimmerJahrgang" text="Jahrgang" prefWidth="100.0"/>
                <TableColumn fx:id="colAktionen" text="Aktionen" prefWidth="240.0"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <Label fx:id="lblHinweis" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnSchwimmerNeu" text="Erstellen"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
