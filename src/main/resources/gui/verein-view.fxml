<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.controller.ClubController" prefHeight="672.0" prefWidth="1200.0">

    <!-- LINKS: alle Schwimmer/innen des ausgewählten Vereins -->
    <center>
        <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="6">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <children>
                        <Label text="Schwimmer/innen des Vereins" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblVereinSchwimmerHinweis" wrapText="true"/>
                        <ListView fx:id="vereinSchwimmerListView" prefHeight="600.0"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- RECHTS: Vereinsauswahl + Aktionen -->
    <right>
        <VBox spacing="10" prefWidth="280.0" BorderPane.alignment="TOP_CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <Label text="Verein auswählen" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblVereineHinweis" wrapText="true"/>
                <ScrollPane fitToWidth="true" prefHeight="300.0">
                    <content>
                        <ListView fx:id="vereinAuswahlListView" prefHeight="290.0"/>
                    </content>
                </ScrollPane>
                <Button fx:id="btnVereinNeu" text="Verein erstellen"
                        onAction="#onVereinNeuClick" maxWidth="Infinity"/>
                <Button fx:id="btnVereinBearbeiten" text="Verein bearbeiten"
                        maxWidth="Infinity"/>
                <Button fx:id="btnSchwimmerAusDatei" text="Schwimmer/innen aus CSV importieren"
                        onAction="#onSchwimmerAusDateiImportierenClick" maxWidth="Infinity"/>
            </children>
        </VBox>
    </right>

</BorderPane>
